#!/bin/bash
# consens.io workbench: one command of the agent (agent_vm.agent_argv,
# docs/agent-mode.md "Arbeitsplatz"). Started as root by the provider's user
# (sudo -n), never by the agent, whose user cannot open this folder:
#   agent-run [--terminal] <seconds> <folder> <program> [args...]
# --terminal: the user's own terminal (routers/agent_workspace.py) with
# the same rights and a terminal type for its programs.
# 1. enters a mount namespace of its own without the provider's management
#    socket (/.sprite/api.sock: checkpoints, services, the VM's lifetime),
#    its checkpoints and its logs; the runtimes in /.sprite/bin stay;
# 2. gives it a /tmp of its own ($tmp, the same for all its commands): the
#    browser's screen and Chrome run on this computer as
#    the provider's user, and their sockets and locks are in the real /tmp,
#    where the agent could put its own in their way;
# 3. lets the user's browser go first when memory or the processor run
#    short: the kernel ends the agent's processes before Chrome when
#    memory runs out
#    (oom_score_adj 800; the Sprite's root lacks CAP_SYS_RESOURCE, so the
#    agent's user could lower it again, which no build does, test Sprite
#    2026-11-04), and they run at nice 10;
# 4. makes no user namespaces (nouserns.py, a seccomp filter): they let
#    an ordinary user reach the kernel's parts that
#    are otherwise root's, the usual way of its flaws from the agent's user
#    to root, and with root to the browser's sign-ins;
# 5. becomes the agent's user with no way back to root (setpriv
#    --no-new-privs: no sudo, no setuid program) in a clean environment;
# 6. goes to the folder and runs the program under coreutils timeout.
# Exit 125: the namespace or the filter could not be made, so nothing ran.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
user=agent
home=/home/agent
tmp=/var/lib/consens/agent-tmp
term=dumb

if [ "${1:-}" = "--inside" ]; then
  shift
  term=$1
  shift
  # Only in a namespace of its own: here the mounts would hide the socket
  # from the provider's own programs as well.
  if [ "$(readlink /proc/self/ns/mnt)" = "$(readlink /proc/1/ns/mnt)" ]; then
    echo "agent-run: not in a namespace of its own" >&2
    exit 125
  fi
  seconds=$1
  folder=$2
  shift 2
  mount --bind /dev/null /.sprite/api.sock || exit 125
  for hidden in /.sprite/checkpoints /.sprite/logs; do
    if [ -d "$hidden" ]; then
      mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=0755 consens-hidden "$hidden" || exit 125
    fi
  done
  [ -d "$tmp" ] && [ ! -L "$tmp" ] || exit 125
  mount --bind "$tmp" /tmp || exit 125
  umask 022
  # Precedence only, never a reason to run nothing.
  echo 800 >/proc/self/oom_score_adj 2>/dev/null || true
  renice -n 10 -p $$ >/dev/null 2>&1 || true
  exec /usr/bin/python3 -I "$here/nouserns.py" \
    setpriv --reuid="$user" --regid="$user" --init-groups --no-new-privs --inh-caps=-all -- \
    /usr/bin/env -i HOME="$home" USER="$user" LOGNAME="$user" SHELL=/bin/bash LANG=C.UTF-8 TERM="$term" \
    PATH="$home/.local/bin:/.sprite/bin:/usr/local/bin:/usr/bin:/bin" \
    /bin/bash -c 'cd -- "$1" 2>/dev/null || { echo "No such folder: $1" >&2; exit 1; }
seconds=$2; shift 2; exec timeout --kill-after=5 "$seconds" "$@"' agent-run "$folder" "$seconds" "$@"
fi

if [ "${1:-}" = "--terminal" ]; then
  shift
  term=xterm-256color
fi
if [ "$#" -lt 3 ] || [ "$(id -u)" != 0 ] || ! id -u "$user" >/dev/null 2>&1; then
  echo "agent-run: usage: sudo agent-run [--terminal] <seconds> <folder> <program> [args...]" >&2
  exit 125
fi
exec unshare --mount --propagation private -- /bin/bash "$0" --inside "$term" "$@"
